PROGRAM fixed CONTEXT VOID
USE standard
BEGIN
   PROC f = (REAL v, INT width, after) VOID:
      print(("fixed(", float(v, 12, 4, 3), ",", whole(width, 0), ",",
             whole(after, 0), ") = [", fixed(v, width, after), "]", newline));
   []REAL values = (0.0, 1.0, -1.0, 3.14159, -2.5, 1234.5678, 0.001);
   FOR i TO UPB values DO
      f(values[i], 0, 0);
      f(values[i], 8, 2);
      f(values[i], -8, 2);
      f(values[i], 6, 0);
      f(values[i], -6, 0);
      f(values[i], 4, 3)
   OD;
   print(("int fixed [", fixed(42, 5, 0), "] [", fixed(0, 3, 0), "] [",
          fixed(-7, 4, 1), "]", newline))
END
FINISH
