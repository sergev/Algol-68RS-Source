#!/bin/sh
#
# Verify the build tree, without installing:
#  1. self-hosting fixed point: C generated by the stage-1 compiler
#     equals C generated by the stage-2 compiler built from it;
#  2. scripts/runtests: tests/, examples, examples/tests, examples/logic.
# Works on a scratch copy; the source tree is left untouched.
#
set -e

TOP=$(cd "$(dirname "$0")/.." && pwd)
WORK=$(mktemp -d "${TMPDIR:-/tmp}/a68check.XXXXXX")
trap 'rm -rf "$WORK"' EXIT
T=$WORK/tree
ADIRS="a68config liba68prel src qad"
export A68_NAMESEED=nameseed
unset MAKEFLAGS MAKELEVEL MFLAGS
J=-j$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)

fail() {
    echo "check: FAILED: $*" >&2
    [ -f "$2" ] && tail -n 30 "$2" >&2
    exit 1
}

# Copy generated .c/.m files of all Algol 68 dirs to $1.
save() {
    for d in $ADIRS; do
        mkdir -p "$1/$d"
        cp "$T/$d"/*.c "$T/$d"/*.m "$1/$d"
    done
}

echo "check: copying tree to $T"
mkdir "$T"
(cd "$TOP" && tar cf - --exclude=.git .) | (cd "$T" && tar xf -)
rm -rf "$T/examples/tests/lib"

echo "check: translating with stage-1 compiler"
make $J -C "$T" Translate >"$WORK/tr1.log" 2>&1 || fail "stage-1 translate" "$WORK/tr1.log"
save "$WORK/gen1"

echo "check: building stage-2 compiler"
rm -f "$T/c-stamp" "$T/q-stamp"
make $J -C "$T" >"$WORK/build2.log" 2>&1 || fail "stage-2 build" "$WORK/build2.log"

echo "check: translating with stage-2 compiler"
make $J -C "$T" Translate >"$WORK/tr2.log" 2>&1 || fail "stage-2 translate" "$WORK/tr2.log"
save "$WORK/gen2"

# Ignore translation timestamps (.c) and spec change times (.m).
diff -r -I 'translation_time = \|spec_change_time = ' -I '^[0-9]\{10\}$' \
    "$WORK/gen1" "$WORK/gen2" >"$WORK/fixpoint.diff" ||
    fail "stage-1 and stage-2 output differ" "$WORK/fixpoint.diff"
echo "check: fixed point OK"

# qad Translate removes liba68s.a; rebuild from stage-2 output.
rm -f "$T/c-stamp" "$T/q-stamp"
make $J -C "$T" >"$WORK/build3.log" 2>&1 || fail "stage-3 build" "$WORK/build3.log"

sh "$T/scripts/runtests" "$T" "$WORK/tests" || fail "tests"

echo "check: all passed"
