#!/bin/sh
#
# Verify the build tree, without installing:
#  1. self-hosting fixed point: C generated by the stage-1 compiler
#     equals C generated by the stage-2 compiler built from it;
#  2. compile all examples, run examples/tests and examples/logic.
# Works on a scratch copy; the source tree is left untouched.
#
set -e

TOP=$(cd "$(dirname "$0")/.." && pwd)
WORK=$(mktemp -d "${TMPDIR:-/tmp}/a68check.XXXXXX")
trap 'rm -rf "$WORK"' EXIT
T=$WORK/tree
ADIRS="a68config liba68prel src qad"
export A68_NAMESEED=nameseed
unset MAKEFLAGS MAKELEVEL MFLAGS

fail() {
    echo "check: FAILED: $*" >&2
    [ -f "$2" ] && tail -n 30 "$2" >&2
    exit 1
}

# Copy generated .c/.m files of all Algol 68 dirs to $1.
save() {
    for d in $ADIRS; do
        mkdir -p "$1/$d"
        cp "$T/$d"/*.c "$T/$d"/*.m "$1/$d"
    done
}

echo "check: copying tree to $T"
mkdir "$T"
(cd "$TOP" && tar cf - --exclude=.git .) | (cd "$T" && tar xf -)
rm -rf "$T/examples/tests/lib"

echo "check: translating with stage-1 compiler"
make -C "$T" Translate >"$WORK/tr1.log" 2>&1 || fail "stage-1 translate" "$WORK/tr1.log"
save "$WORK/gen1"

echo "check: building stage-2 compiler"
rm -f "$T/c-stamp" "$T/q-stamp"
make -C "$T" >"$WORK/build2.log" 2>&1 || fail "stage-2 build" "$WORK/build2.log"

echo "check: translating with stage-2 compiler"
make -C "$T" Translate >"$WORK/tr2.log" 2>&1 || fail "stage-2 translate" "$WORK/tr2.log"
save "$WORK/gen2"

# Ignore translation timestamps (.c) and spec change times (.m).
diff -r -I 'translation_time = \|spec_change_time = ' -I '^[0-9]\{10\}$' \
    "$WORK/gen1" "$WORK/gen2" >"$WORK/fixpoint.diff" ||
    fail "stage-1 and stage-2 output differ" "$WORK/fixpoint.diff"
echo "check: fixed point OK"

# qad Translate removes liba68s.a; rebuild from stage-2 output.
rm -f "$T/c-stamp" "$T/q-stamp"
make -C "$T" >"$WORK/build3.log" 2>&1 || fail "stage-3 build" "$WORK/build3.log"

# Point ca at the build tree instead of the installed files.
R=$WORK/root
mkdir "$R"
for f in a68config/a68config.m qad/standard.m qad/liba68s.a \
         library/Afirst.o library/liba68.a library/liba68gc.a; do
    ln -s "$T/$f" "$R/"
done
export CA_A68TOC="$T/src/a68toc"
export CA_ROOT="$R"
export CA_LIBDIR="$R"
export CA_INCLUDES="-I$T/include/algol68 -I$T/include"
PATH=$T/scripts:$PATH
export PATH

cd "$T/examples"
for f in *.a68; do
    ca "$f" >"$WORK/ex.log" 2>&1 || fail "example $f" "$WORK/ex.log"
done
echo "check: examples compile OK"

make -C "$T/examples/tests" test >"$WORK/tests.log" 2>&1 ||
    fail "examples/tests" "$WORK/tests.log"
echo "check: examples/tests OK"

# Its Makefile needs Algol W (awe.mk), so run the logic68 steps here.
(cd "$T/examples/logic" &&
    ca -u AAAAAAA logic68.a68 &&
    sh tests.sh ./logic68 &&
    ./logic68 '~a \/ b, a -> b' >actual.output &&
    diff expected.output actual.output) >"$WORK/logic.log" 2>&1 ||
    fail "examples/logic" "$WORK/logic.log"
echo "check: examples/logic OK"

echo "check: all passed"
